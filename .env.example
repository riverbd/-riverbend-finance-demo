# Supabase connection — copy this file to `.env` and fill in real values.
#
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed.
# Vite only exposes variables prefixed with VITE_ to client-side code,
# so both of these are PUBLIC and readable by anyone with the site open.
# Never put a service_role / secret key here — only the publishable (anon) key.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
